backend/*.db
backend/*.sqlite3

# Local uploads
backend/app/static/uploads/*.jpg
backend/app/static/uploads/*.jpeg
backend/app/static/uploads/*.png
backend/app/static/uploads/*.webp

# IDE
.vscode/
.idea/
*.iml

# OS
.DS_Store
Thumbs.db
